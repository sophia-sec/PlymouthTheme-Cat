# Modified 2026-10-29: black background, transparent cropped frames,
# new password field for LUKS, adjustable animation speed.
# Original theme by krishnan793 (GPL-3.0).

# PlymouthTheme-Cat (black variant with password field)

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

#----------------------------------------- Cat animation ---------------------------------

for (i = 0; i < 111; i++)
  cat_image[i] = Image("progress-" + i + ".png");

cat_w = cat_image[0].GetWidth();
cat_h = cat_image[0].GetHeight();
cat_x = screen_w / 2 - cat_w / 2;
cat_y = screen_h / 2 - cat_h / 2 - 40;

cat_sprite = Sprite();
cat_sprite.SetPosition(cat_x, cat_y, 1);

speed = 2;
progress = 0;

fun refresh_callback ()
  {
    cat_sprite.SetImage(cat_image[Math.Int(progress / speed) % 111]);
    progress++;
  }

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Password field --------------------------------

entry_image  = Image("entry.png");
lock_image   = Image("lock.png");
bullet_image = Image("bullet.png");

# Gap between cat and field (pixels). Increase to move the field lower.
field_gap = 60;

entry_x = screen_w / 2 - entry_image.GetWidth() / 2;
entry_y = cat_y + cat_h + field_gap;
if (entry_y + entry_image.GetHeight() > screen_h - 40)
  entry_y = screen_h - 40 - entry_image.GetHeight();

entry_sprite = Sprite(entry_image);
entry_sprite.SetPosition(entry_x, entry_y, 100);
entry_sprite.SetOpacity(0);

lock_sprite = Sprite(lock_image);
lock_sprite.SetPosition(entry_x + 20, entry_y + entry_image.GetHeight() / 2 - lock_image.GetHeight() / 2, 101);
lock_sprite.SetOpacity(0);

bullets_start = entry_x + 52;
bullets_max = Math.Int((entry_image.GetWidth() - 52 - 20) / bullet_image.GetWidth());

for (i = 0; i < bullets_max; i++)
  {
    bullet_sprite[i] = Sprite(bullet_image);
    bullet_sprite[i].SetPosition(bullets_start + i * bullet_image.GetWidth(),
                                 entry_y + entry_image.GetHeight() / 2 - bullet_image.GetHeight() / 2, 102);
    bullet_sprite[i].SetOpacity(0);
  }

fun display_normal_callback ()
  {
    entry_sprite.SetOpacity(0);
    lock_sprite.SetOpacity(0);
    for (i = 0; i < bullets_max; i++)
      bullet_sprite[i].SetOpacity(0);
  }

fun display_password_callback (prompt, bullets)
  {
    entry_sprite.SetOpacity(1);
    lock_sprite.SetOpacity(1);
    for (i = 0; i < bullets_max; i++)
      {
        if (i < bullets)
          bullet_sprite[i].SetOpacity(1);
        else
          bullet_sprite[i].SetOpacity(0);
      }
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
